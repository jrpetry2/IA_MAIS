<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="SaphMovel.Pages.ImpressaoBoletimPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:vm="clr-namespace:SaphMovel.ViewModels"
	x:DataType="vm:ImpressaoBoletimViewModel"
	Style="{StaticResource SaphModalPage}"
	Title="Impressão do Boletim">

	<!-- Assinatura fora do ScrollView: senão o gesto vertical dispara a rolagem em vez de pintar. -->
	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
		<Grid
			Grid.Row="0"
			ColumnDefinitions="Auto,*"
			Style="{StaticResource SaphModalHeaderBar}">
			<Button
				Grid.Column="0"
				Command="{Binding VoltarCommand}"
				Style="{StaticResource SaphModalBackButton}"
				Text="←" />
			<Label
				Grid.Column="1"
				Style="{StaticResource SaphModalTitle}"
				Text="Impressão do Boletim" />
		</Grid>

		<Border Grid.Row="1" Style="{StaticResource SaphPatientCard}">
			<HorizontalStackLayout Spacing="10">
				<Label FontSize="22" Text="{Binding PatientEmoji}" VerticalOptions="Center" />
				<Label Style="{StaticResource SaphPatientSummary}" Text="{Binding PatientSummary}" />
			</HorizontalStackLayout>
		</Border>

		<Label
			Grid.Row="2"
			Style="{StaticResource SaphRequiredHint}"
			Text="* CAMPO OBRIGATÓRIO" />

		<ScrollView Grid.Row="3" VerticalOptions="Fill">
			<VerticalStackLayout Padding="16,0,16,8" Spacing="16">
				<Border Padding="16,14" Style="{StaticResource SaphModalSectionCard}">
					<VerticalStackLayout Spacing="14">
						<HorizontalStackLayout Spacing="12" VerticalOptions="Center">
							<CheckBox
								Color="{StaticResource SaphBoletimTeal}"
								IsChecked="{Binding Form.DownloadArquivo, Mode=TwoWay}"
								VerticalOptions="Center" />
							<Label
								FontSize="14"
								LineBreakMode="WordWrap"
								Text="Download do Arquivo"
								TextColor="{DynamicResource SaphModalFieldText}"
								VerticalOptions="Center" />
						</HorizontalStackLayout>
						<HorizontalStackLayout Spacing="12" VerticalOptions="Center">
							<CheckBox
								Color="{StaticResource SaphBoletimTeal}"
								IsChecked="{Binding Form.CopiaFisica, Mode=TwoWay}"
								VerticalOptions="Center" />
							<Label
								FontSize="14"
								LineBreakMode="WordWrap"
								Text="Cópia Física"
								TextColor="{DynamicResource SaphModalFieldText}"
								VerticalOptions="Center" />
						</HorizontalStackLayout>
						<HorizontalStackLayout Spacing="12" VerticalOptions="Center">
							<CheckBox
								Color="{StaticResource SaphBoletimTeal}"
								IsChecked="{Binding Form.EnviarEmail, Mode=TwoWay}"
								VerticalOptions="Center" />
							<Label
								FontSize="14"
								LineBreakMode="WordWrap"
								Text="Enviar por e-mail"
								TextColor="{DynamicResource SaphModalFieldText}"
								VerticalOptions="Center" />
						</HorizontalStackLayout>

						<VerticalStackLayout Spacing="6">
							<Label Style="{StaticResource SaphFieldCaption}" Text="Destinatário *" />
							<Entry
								Placeholder="Rua Exemplo, 123 - Bairro - Cidade"
								Style="{StaticResource SaphFieldEntry}"
								Text="{Binding Form.Destinatario}" />
						</VerticalStackLayout>

						<VerticalStackLayout Spacing="6">
							<Label Style="{StaticResource SaphFieldCaption}" Text="E-mail (Pode ser mais de um) *" />
							<Entry
								Keyboard="Email"
								Placeholder="E-mail para envio"
								Style="{StaticResource SaphFieldEntry}"
								Text="{Binding Form.Email}" />
						</VerticalStackLayout>
					</VerticalStackLayout>
				</Border>

				<Grid ColumnDefinitions="Auto,*" Style="{StaticResource SaphSectionHeaderBar}">
					<BoxView
						Grid.Column="0"
						WidthRequest="4"
						Color="{StaticResource SaphBoletimTeal}"
						VerticalOptions="Fill" />
					<Label
						Grid.Column="1"
						Margin="12,0,12,0"
						Style="{StaticResource SaphSectionHeaderTitle}"
						Text="Autorização" />
				</Grid>

				<Grid ColumnDefinitions="4*,6*" ColumnSpacing="12">
					<VerticalStackLayout Grid.Column="0" Spacing="6">
						<Label Style="{StaticResource SaphFieldCaption}" Text="Pessoa *" />
						<Border
							Padding="4,0"
							BackgroundColor="{DynamicResource SaphModalField}"
							Stroke="{DynamicResource SaphModalStroke}"
							StrokeThickness="1">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="8" />
							</Border.StrokeShape>
							<Picker
								Title="Selecione"
								BackgroundColor="Transparent"
								ItemsSource="{Binding PessoaItems}"
								SelectedItem="{Binding Form.Pessoa, Mode=TwoWay}"
								Style="{StaticResource SaphFieldPicker}" />
						</Border>
					</VerticalStackLayout>
					<VerticalStackLayout Grid.Column="1" Spacing="6">
						<Label Style="{StaticResource SaphFieldCaption}" Text="Nome *" />
						<Entry
							Placeholder="Nome completo"
							Style="{StaticResource SaphFieldEntry}"
							Text="{Binding Form.Nome}" />
					</VerticalStackLayout>
				</Grid>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaption}" Text="Tipo / Nº Documento *" />
					<Entry
						Placeholder="RG, CPF, CNH…"
						Style="{StaticResource SaphFieldEntry}"
						Text="{Binding Form.TipoNumeroDocumento}" />
				</VerticalStackLayout>
			</VerticalStackLayout>
		</ScrollView>

		<!-- Folha de assinatura: mantém-se clara em qualquer tema (é papel). -->
		<Border
			Grid.Row="4"
			Margin="16,0,16,8"
			Padding="0"
			BackgroundColor="{StaticResource SaphSignatureSheet}"
			Stroke="{StaticResource SaphSignatureRule}"
			StrokeThickness="1">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="10" />
			</Border.StrokeShape>
			<Grid RowDefinitions="Auto,200,Auto">
				<Button
					Grid.Row="0"
					Margin="0,4,8,0"
					Padding="8,4"
					BackgroundColor="Transparent"
					BorderWidth="0"
					Command="{Binding LimparAssinaturaCommand}"
					HorizontalOptions="End"
					SemanticProperties.Description="Limpar assinatura"
					Text="LIMPAR"
					TextColor="{StaticResource SaphSignatureInk}"
					VerticalOptions="Start" />
				<GraphicsView
					x:Name="SignatureView"
					Grid.Row="1"
					BackgroundColor="{StaticResource SaphSignatureCanvas}"
					HorizontalOptions="Fill"
					VerticalOptions="Fill" />
				<VerticalStackLayout
					Grid.Row="2"
					Padding="0,0,0,8"
					Spacing="4">
					<BoxView HeightRequest="1" Color="{StaticResource SaphSignatureRule}" />
					<Label
						FontSize="12"
						HorizontalTextAlignment="Center"
						Text="Assine aqui"
						TextColor="{StaticResource SaphSignatureHint}" />
				</VerticalStackLayout>
			</Grid>
		</Border>

		<Grid
			Grid.Row="5"
			ColumnDefinitions="*,*"
			Style="{StaticResource SaphModalFooterBar}">
			<Button
				Grid.Column="0"
				Command="{Binding VoltarCommand}"
				SemanticProperties.Description="Voltar sem guardar"
				Style="{StaticResource SaphSecondaryActionButton}"
				Text="VOLTAR" />
			<Button
				Grid.Column="1"
				Command="{Binding EnviarCommand}"
				SemanticProperties.Description="Enviar impressão do boletim"
				Style="{StaticResource SaphActionButton}"
				Text="ENVIAR" />
		</Grid>
	</Grid>
</ContentPage>
