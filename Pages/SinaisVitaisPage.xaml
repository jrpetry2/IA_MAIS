<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="SaphMovel.Pages.SinaisVitaisPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:SaphMovel.Controls"
	xmlns:vm="clr-namespace:SaphMovel.ViewModels"
	x:DataType="vm:SinaisVitaisViewModel"
	Style="{StaticResource SaphModalPage}"
	Title="Sinais Vitais">

	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
		<Grid
			Grid.Row="0"
			ColumnDefinitions="Auto,*"
			Style="{StaticResource SaphModalHeaderBar}">
			<Button
				Grid.Column="0"
				Command="{Binding VoltarCommand}"
				Style="{StaticResource SaphModalBackButton}"
				Text="←" />
			<Label
				Grid.Column="1"
				Style="{StaticResource SaphModalTitle}"
				Text="Sinais Vitais" />
		</Grid>

		<Border Grid.Row="1" Style="{StaticResource SaphPatientCard}">
			<HorizontalStackLayout Spacing="10">
				<Label FontSize="22" Text="{Binding PatientEmoji}" VerticalOptions="Center" />
				<Label Style="{StaticResource SaphPatientSummary}" Text="{Binding PatientSummary}" />
			</HorizontalStackLayout>
		</Border>

		<Label
			Grid.Row="2"
			Style="{StaticResource SaphRequiredHint}"
			Text="* CAMPO OBRIGATÓRIO" />

		<ScrollView Grid.Row="3">
			<VerticalStackLayout Padding="16,0,16,24" Spacing="14">
				<Grid
					ColumnDefinitions="*,*,*"
					ColumnSpacing="10"
					RowDefinitions="Auto,Auto,Auto,Auto"
					RowSpacing="12">
					<!-- Linha 1 -->
					<VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
						<Label Style="{StaticResource SaphFieldCaption}" Text="PAS" />
						<Entry
							Keyboard="Numeric"
							Placeholder="—"
							Style="{StaticResource SaphFieldEntry}"
							Text="{Binding Form.Pas}" />
					</VerticalStackLayout>
					<VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
						<Label Style="{StaticResource SaphFieldCaption}" Text="PAD" />
						<Entry
							Keyboard="Numeric"
							Placeholder="—"
							Style="{StaticResource SaphFieldEntry}"
							Text="{Binding Form.Pad}" />
					</VerticalStackLayout>
					<VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="4">
						<Label Style="{StaticResource SaphFieldCaption}" Text="FC" />
						<Entry
							Keyboard="Numeric"
							Placeholder="—"
							Style="{StaticResource SaphFieldEntry}"
							Text="{Binding Form.Fc}" />
					</VerticalStackLayout>
					<!-- Linha 2 -->
					<VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
						<Label Style="{StaticResource SaphFieldCaption}" Text="FR" />
						<Entry
							Keyboard="Numeric"
							Placeholder="—"
							Style="{StaticResource SaphFieldEntry}"
							Text="{Binding Form.Fr}" />
					</VerticalStackLayout>
					<VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
						<Label Style="{StaticResource SaphFieldCaption}" Text="Sat. O₂" />
						<Entry
							Keyboard="Numeric"
							Placeholder="—"
							Style="{StaticResource SaphFieldEntry}"
							Text="{Binding Form.SatO2}" />
					</VerticalStackLayout>
					<VerticalStackLayout Grid.Row="1" Grid.Column="2" Spacing="4">
						<Label Style="{StaticResource SaphFieldCaption}" Text="Temp.Ax" />
						<Entry
							Keyboard="Numeric"
							Placeholder="—"
							Style="{StaticResource SaphFieldEntry}"
							Text="{Binding Form.TempAx}" />
					</VerticalStackLayout>
					<!-- Linha 3 -->
					<VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
						<Label Style="{StaticResource SaphFieldCaption}" Text="HGT" />
						<Entry
							Keyboard="Numeric"
							Placeholder="—"
							Style="{StaticResource SaphFieldEntry}"
							Text="{Binding Form.Hgt}" />
					</VerticalStackLayout>
					<VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
						<Label Style="{StaticResource SaphFieldCaption}" Text="Glasgow" />
						<Entry
							Keyboard="Numeric"
							Placeholder="—"
							Style="{StaticResource SaphFieldEntry}"
							Text="{Binding Form.Glasgow}" />
					</VerticalStackLayout>
					<VerticalStackLayout Grid.Row="2" Grid.Column="2" Spacing="4">
						<Label Style="{StaticResource SaphFieldCaption}" Text="RTS" />
						<Entry
							Keyboard="Numeric"
							Placeholder="—"
							Style="{StaticResource SaphFieldEntry}"
							Text="{Binding Form.Rts}" />
					</VerticalStackLayout>
					<!-- Linha 4 -->
					<VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="4">
						<Label Style="{StaticResource SaphFieldCaption}" Text="PTS" />
						<Entry
							Keyboard="Numeric"
							Placeholder="—"
							Style="{StaticResource SaphFieldEntry}"
							Text="{Binding Form.Pts}" />
					</VerticalStackLayout>
				</Grid>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaption}" Text="Evolução" />
					<Editor
						AutoSize="TextChanges"
						MinimumHeightRequest="140"
						Placeholder="Descreva a evolução..."
						Style="{StaticResource SaphFieldEditor}"
						Text="{Binding Form.Evolucao}" />
				</VerticalStackLayout>

				<controls:OuvirPanel x:Name="OuvirPanel" />
			</VerticalStackLayout>
		</ScrollView>

		<Grid
			Grid.Row="4"
			ColumnDefinitions="*,*"
			Style="{StaticResource SaphModalFooterBar}">
			<Button
				Grid.Column="0"
				Command="{Binding VoltarCommand}"
				SemanticProperties.Description="Voltar sem guardar"
				Style="{StaticResource SaphSecondaryActionButton}"
				Text="VOLTAR" />
			<Button
				Grid.Column="1"
				Command="{Binding EnviarCommand}"
				SemanticProperties.Description="Enviar sinais vitais"
				Style="{StaticResource SaphActionButton}"
				Text="ENVIAR" />
		</Grid>
	</Grid>
</ContentPage>
