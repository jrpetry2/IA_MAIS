<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="SaphMovel.Pages.IdentificacaoPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:SaphMovel.Controls"
	xmlns:vm="clr-namespace:SaphMovel.ViewModels"
	x:DataType="vm:IdentificacaoViewModel"
	Style="{StaticResource SaphModalPage}"
	Title="Identificação">

	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
		<!-- Barra topo -->
		<Grid
			Grid.Row="0"
			ColumnDefinitions="Auto,*"
			Style="{StaticResource SaphModalHeaderBar}">
			<Button
				Grid.Column="0"
				Command="{Binding VoltarCommand}"
				Style="{StaticResource SaphModalBackButton}"
				Text="←" />
			<Label
				Grid.Column="1"
				Style="{StaticResource SaphModalTitle}"
				Text="Identificação" />
		</Grid>

		<!-- Resumo paciente -->
		<Border Grid.Row="1" Style="{StaticResource SaphPatientCard}">
			<HorizontalStackLayout Spacing="10">
				<Label FontSize="22" Text="{Binding PatientEmoji}" VerticalOptions="Center" />
				<Label Style="{StaticResource SaphPatientSummary}" Text="{Binding PatientSummary}" />
			</HorizontalStackLayout>
		</Border>

		<Label
			Grid.Row="2"
			Style="{StaticResource SaphRequiredHint}"
			Text="* CAMPO OBRIGATÓRIO" />

		<ScrollView Grid.Row="3">
			<VerticalStackLayout Padding="16,0,16,24" Spacing="16">
				<Label
					FontSize="12"
					LineBreakMode="WordWrap"
					Text="Dite a identificação com OUVIR (nome, idade, CPF, mãe, alergias…), ou edite os campos manualmente."
					TextColor="{DynamicResource SaphTextSecondary}" />

				<controls:OuvirPanel x:Name="OuvirPanel" />

				<!-- Secção: Identificação do Paciente -->
				<Grid ColumnDefinitions="Auto,*" Style="{StaticResource SaphSectionHeaderBar}">
					<BoxView
						Grid.Column="0"
						WidthRequest="4"
						Color="{StaticResource SaphBoletimTeal}"
						VerticalOptions="Fill" />
					<Label
						Grid.Column="1"
						Margin="12,0,12,0"
						Style="{StaticResource SaphSectionHeaderTitle}"
						Text="Identificação do Paciente" />
				</Grid>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaption}" Text="Nome *" />
					<Entry
						Placeholder="Nome completo"
						Style="{StaticResource SaphFieldEntry}"
						Text="{Binding Form.Nome}" />
				</VerticalStackLayout>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaption}" Text="Sexo *" />
					<Picker
						Title="Selecione"
						ItemsSource="{Binding SexoItems}"
						SelectedItem="{Binding SexoPickerItem, Mode=TwoWay}"
						Style="{StaticResource SaphFieldPicker}" />
					<Label
						FontSize="12"
						IsVisible="{Binding ShowSexoSugeridoHint}"
						LineBreakMode="WordWrap"
						Text="Sexo sugerido pela IA a partir do nome — confira."
						TextColor="{DynamicResource SaphTextSecondary}" />
				</VerticalStackLayout>

				<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
					<VerticalStackLayout Grid.Column="0" Spacing="6">
						<Label Style="{StaticResource SaphFieldCaption}" Text="Idade *" />
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
							<Entry
								Grid.Column="0"
								Keyboard="Numeric"
								Placeholder="0"
								Style="{StaticResource SaphFieldEntry}"
								Text="{Binding Form.IdadeAnos}" />
							<Border
								Grid.Column="1"
								Padding="10,0"
								BackgroundColor="{DynamicResource SaphModalCard}"
								StrokeThickness="0"
								VerticalOptions="Center">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="6" />
								</Border.StrokeShape>
								<Label
									Style="{StaticResource SaphFieldCaption}"
									Text="ANOS"
									VerticalOptions="Center" />
							</Border>
						</Grid>
					</VerticalStackLayout>
					<VerticalStackLayout Grid.Column="1" Spacing="6">
						<Label Style="{StaticResource SaphFieldCaption}" Text=" " />
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
							<Entry
								Grid.Column="0"
								Keyboard="Numeric"
								Placeholder="0"
								Style="{StaticResource SaphFieldEntry}"
								Text="{Binding Form.IdadeMeses}" />
							<Border
								Grid.Column="1"
								Padding="10,0"
								BackgroundColor="{DynamicResource SaphModalCard}"
								StrokeThickness="0"
								VerticalOptions="Center">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="6" />
								</Border.StrokeShape>
								<Label
									Style="{StaticResource SaphFieldCaption}"
									Text="MESES"
									VerticalOptions="Center" />
							</Border>
						</Grid>
					</VerticalStackLayout>
				</Grid>

				<!-- Paciente Ignorado -->
				<Grid
					Margin="0,8,0,0"
					ColumnDefinitions="Auto,*"
					Style="{StaticResource SaphSectionHeaderBar}">
					<BoxView
						Grid.Column="0"
						WidthRequest="4"
						Color="{StaticResource SaphBoletimTeal}"
						VerticalOptions="Fill" />
					<Label
						Grid.Column="1"
						Margin="12,0,12,0"
						Style="{StaticResource SaphSectionHeaderTitle}"
						Text="Paciente Ignorado" />
				</Grid>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaption}" Text="CPF" />
					<Entry
						Keyboard="Numeric"
						Placeholder="000.000.000-00"
						Style="{StaticResource SaphFieldEntry}"
						Text="{Binding Form.Cpf}" />
				</VerticalStackLayout>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaption}" Text="Cor" />
					<Picker
						Title="Selecione"
						ItemsSource="{Binding CorItems}"
						SelectedItem="{Binding Form.Cor, Mode=TwoWay}"
						Style="{StaticResource SaphFieldPicker}" />
				</VerticalStackLayout>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaption}" Text="Característica Física" />
					<Entry
						Placeholder="Descreva brevemente"
						Style="{StaticResource SaphFieldEntry}"
						Text="{Binding Form.CaracteristicaFisica}" />
				</VerticalStackLayout>

				<!-- Paciente -->
				<Grid
					Margin="0,8,0,0"
					ColumnDefinitions="Auto,*"
					Style="{StaticResource SaphSectionHeaderBar}">
					<BoxView
						Grid.Column="0"
						WidthRequest="4"
						Color="{StaticResource SaphBoletimTeal}"
						VerticalOptions="Fill" />
					<Label
						Grid.Column="1"
						Margin="12,0,12,0"
						Style="{StaticResource SaphSectionHeaderTitle}"
						Text="Paciente" />
				</Grid>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaption}" Text="Nome Social" />
					<Entry
						Placeholder="Nome social"
						Style="{StaticResource SaphFieldEntry}"
						Text="{Binding Form.NomeSocial}" />
				</VerticalStackLayout>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaption}" Text="Nome da Mãe" />
					<Entry
						Placeholder="Nome completo da mãe"
						Style="{StaticResource SaphFieldEntry}"
						Text="{Binding Form.NomeMae}" />
				</VerticalStackLayout>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaption}" Text="Data de Nascimento" />
					<Entry
						Placeholder="dd/mm/aaaa"
						Style="{StaticResource SaphFieldEntry}"
						Text="{Binding Form.DataNascimentoText}" />
				</VerticalStackLayout>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaption}" Text="Alergias" />
					<Editor
						AutoSize="TextChanges"
						MinimumHeightRequest="100"
						Placeholder="Descreva alergias conhecidas"
						Style="{StaticResource SaphFieldEditor}"
						Text="{Binding Form.Alergias}" />
				</VerticalStackLayout>
			</VerticalStackLayout>
		</ScrollView>

		<!-- Rodapé -->
		<Grid
			Grid.Row="4"
			ColumnDefinitions="*,*"
			Style="{StaticResource SaphModalFooterBar}">
			<Button
				Grid.Column="0"
				Command="{Binding VoltarCommand}"
				SemanticProperties.Description="Voltar sem guardar"
				Style="{StaticResource SaphSecondaryActionButton}"
				Text="VOLTAR" />
			<Button
				Grid.Column="1"
				Command="{Binding EnviarCommand}"
				SemanticProperties.Description="Enviar identificação"
				Style="{StaticResource SaphActionButton}"
				Text="ENVIAR" />
		</Grid>
	</Grid>
</ContentPage>
