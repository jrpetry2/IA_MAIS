<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="SaphMovel.Pages.AvaliacaoInicialPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:vm="clr-namespace:SaphMovel.ViewModels"
	x:DataType="vm:AvaliacaoInicialViewModel"
	Style="{StaticResource SaphModalPage}"
	Title="Avaliação Inicial">

	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
		<Grid
			Grid.Row="0"
			ColumnDefinitions="Auto,*"
			Style="{StaticResource SaphModalHeaderBar}">
			<Button
				Grid.Column="0"
				Command="{Binding VoltarCommand}"
				Style="{StaticResource SaphModalBackButton}"
				Text="←" />
			<Label
				Grid.Column="1"
				Style="{StaticResource SaphModalTitle}"
				Text="Avaliação Inicial" />
		</Grid>

		<Border Grid.Row="1" Style="{StaticResource SaphPatientCard}">
			<HorizontalStackLayout Spacing="10">
				<Label FontSize="22" Text="{Binding PatientEmoji}" VerticalOptions="Center" />
				<Label Style="{StaticResource SaphPatientSummary}" Text="{Binding PatientSummary}" />
			</HorizontalStackLayout>
		</Border>

		<Label
			Grid.Row="2"
			Style="{StaticResource SaphRequiredHint}"
			Text="* CAMPO OBRIGATÓRIO" />

		<ScrollView Grid.Row="3">
			<VerticalStackLayout Padding="16,0,16,24" Spacing="16">
				<!-- Chegada da Equipe -->
				<Grid ColumnDefinitions="Auto,*" Style="{StaticResource SaphSectionHeaderBar}">
					<BoxView
						Grid.Column="0"
						WidthRequest="4"
						Color="{StaticResource SaphBoletimTeal}"
						VerticalOptions="Fill" />
					<Label
						Grid.Column="1"
						Margin="12,0,12,0"
						Style="{StaticResource SaphSectionHeaderTitle}"
						Text="Chegada da Equipe" />
				</Grid>

				<VerticalStackLayout Spacing="6">
					<Label
						FontSize="13"
						Style="{StaticResource SaphFieldCaptionStrong}"
						Text="REPORTE DA CHEGADA" />
					<Editor
						AutoSize="TextChanges"
						MinimumHeightRequest="120"
						Placeholder="Descreva a chegada da equipe ao local..."
						Style="{StaticResource SaphFieldEditor}"
						Text="{Binding Form.ReporteChegada}" />
				</VerticalStackLayout>

				<!-- ABCD -->
				<Grid
					Margin="0,8,0,0"
					ColumnDefinitions="Auto,*"
					Style="{StaticResource SaphSectionHeaderBar}">
					<BoxView
						Grid.Column="0"
						WidthRequest="4"
						Color="{StaticResource SaphBoletimTeal}"
						VerticalOptions="Fill" />
					<Label
						Grid.Column="1"
						Margin="12,0,12,0"
						Style="{StaticResource SaphSectionHeaderTitle}"
						Text="ABCD" />
				</Grid>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaptionStrong}" Text="A - VIAS AÉREAS" />
					<Picker
						Title="Selecione"
						ItemsSource="{Binding OpcoesViasAereas}"
						SelectedItem="{Binding Form.ViasAereas, Mode=TwoWay}"
						Style="{StaticResource SaphFieldPicker}" />
				</VerticalStackLayout>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaptionStrong}" Text="B - RESPIRAÇÃO" />
					<Picker
						Title="Selecione"
						ItemsSource="{Binding OpcoesRespiracao}"
						SelectedItem="{Binding Form.Respiracao, Mode=TwoWay}"
						Style="{StaticResource SaphFieldPicker}" />
				</VerticalStackLayout>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaptionStrong}" Text="C - CIRCULAÇÃO" />
					<Picker
						Title="Selecione"
						ItemsSource="{Binding OpcoesCirculacao}"
						SelectedItem="{Binding Form.Circulacao, Mode=TwoWay}"
						Style="{StaticResource SaphFieldPicker}" />
				</VerticalStackLayout>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaptionStrong}" Text="D - ABERTURA OCULAR" />
					<Picker
						Title="Selecione"
						ItemsSource="{Binding OpcoesAberturaOcular}"
						SelectedItem="{Binding Form.AberturaOcular, Mode=TwoWay}"
						Style="{StaticResource SaphFieldPicker}" />
				</VerticalStackLayout>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaptionStrong}" Text="D - RESPOSTA MOTORA" />
					<Picker
						Title="Selecione"
						ItemsSource="{Binding OpcoesRespostaMotora}"
						SelectedItem="{Binding Form.RespostaMotora, Mode=TwoWay}"
						Style="{StaticResource SaphFieldPicker}" />
				</VerticalStackLayout>

				<VerticalStackLayout Spacing="6">
					<Label Style="{StaticResource SaphFieldCaptionStrong}" Text="D - RESPOSTA VERBAL" />
					<Picker
						Title="Selecione"
						ItemsSource="{Binding OpcoesRespostaVerbal}"
						SelectedItem="{Binding Form.RespostaVerbal, Mode=TwoWay}"
						Style="{StaticResource SaphFieldPicker}" />
				</VerticalStackLayout>
			</VerticalStackLayout>
		</ScrollView>

		<Grid
			Grid.Row="4"
			ColumnDefinitions="*,*"
			Style="{StaticResource SaphModalFooterBar}">
			<Button
				Grid.Column="0"
				Command="{Binding VoltarCommand}"
				SemanticProperties.Description="Voltar sem guardar"
				Style="{StaticResource SaphSecondaryActionButton}"
				Text="VOLTAR" />
			<Button
				Grid.Column="1"
				Command="{Binding EnviarCommand}"
				SemanticProperties.Description="Enviar avaliação inicial"
				Style="{StaticResource SaphActionButton}"
				Text="ENVIAR" />
		</Grid>
	</Grid>
</ContentPage>
