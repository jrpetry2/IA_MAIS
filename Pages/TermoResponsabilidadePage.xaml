<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="SaphMovel.Pages.TermoResponsabilidadePage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:vm="clr-namespace:SaphMovel.ViewModels"
	x:DataType="vm:TermoResponsabilidadeViewModel"
	Style="{StaticResource SaphModalPage}"
	Title="Termo de Responsabilidade">

	<Grid RowDefinitions="Auto,Auto,*,Auto">
		<Grid
			Grid.Row="0"
			ColumnDefinitions="Auto,*"
			Style="{StaticResource SaphModalHeaderBar}">
			<Button
				Grid.Column="0"
				Command="{Binding VoltarCommand}"
				Style="{StaticResource SaphModalBackButton}"
				Text="←" />
			<Label
				Grid.Column="1"
				Style="{StaticResource SaphModalTitle}"
				Text="Termo de Responsabilidade" />
		</Grid>

		<Border
			Grid.Row="1"
			Margin="16,8,16,12"
			Style="{StaticResource SaphPatientCard}">
			<HorizontalStackLayout Spacing="10">
				<Label FontSize="22" Text="{Binding PatientEmoji}" VerticalOptions="Center" />
				<Label Style="{StaticResource SaphPatientSummary}" Text="{Binding PatientSummary}" />
			</HorizontalStackLayout>
		</Border>

		<ScrollView Grid.Row="2">
			<VerticalStackLayout Padding="16,0,16,20" Spacing="16">
				<Border Padding="16,14" Style="{StaticResource SaphModalSectionCard}">
					<VerticalStackLayout Spacing="14">
						<Label
							FontSize="14"
							Style="{StaticResource SaphFieldCaption}"
							Text="Selecione o Termo" />
						<Border
							Padding="10,4"
							BackgroundColor="{DynamicResource SaphModalField}"
							Stroke="{DynamicResource SaphModalStroke}"
							StrokeThickness="1">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="8" />
							</Border.StrokeShape>
							<Picker
								Title="Termo"
								BackgroundColor="Transparent"
								ItemsSource="{Binding OpcoesTermo}"
								SelectedItem="{Binding Form.TermoSelecionado, Mode=TwoWay}"
								Style="{StaticResource SaphFieldPicker}" />
						</Border>
						<Label
							FontSize="14"
							LineBreakMode="WordWrap"
							Text="{Binding Form.TextoLegalCalculado}"
							TextColor="{DynamicResource SaphModalFieldText}" />
						<Button
							Padding="16,14"
							BackgroundColor="{StaticResource SaphStatusGreenAlt}"
							Command="{Binding AdicionarAssinaturasCommand}"
							CornerRadius="10"
							FontAttributes="Bold"
							MinimumHeightRequest="48"
							SemanticProperties.Description="Adicionar assinaturas ao termo"
							Text="ADICIONAR ASSINATURAS"
							TextColor="{DynamicResource SaphOnActionButton}" />
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>
		</ScrollView>

		<Grid
			Grid.Row="3"
			ColumnDefinitions="*,*"
			Style="{StaticResource SaphModalFooterBar}">
			<Button
				Grid.Column="0"
				Command="{Binding VoltarCommand}"
				SemanticProperties.Description="Voltar sem guardar"
				Style="{StaticResource SaphSecondaryActionButton}"
				Text="VOLTAR" />
			<Button
				Grid.Column="1"
				Command="{Binding EnviarCommand}"
				SemanticProperties.Description="Enviar termo de responsabilidade"
				Style="{StaticResource SaphActionButton}"
				Text="ENVIAR" />
		</Grid>
	</Grid>
</ContentPage>
