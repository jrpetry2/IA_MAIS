<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="SaphMovel.Pages.AvaliacaoFinalPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:vm="clr-namespace:SaphMovel.ViewModels"
	x:DataType="vm:AvaliacaoFinalViewModel"
	Style="{StaticResource SaphModalPage}"
	Title="Avaliação Final">

	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
		<Grid
			Grid.Row="0"
			ColumnDefinitions="Auto,*"
			Style="{StaticResource SaphModalHeaderBar}">
			<Button
				Grid.Column="0"
				Command="{Binding VoltarCommand}"
				Style="{StaticResource SaphModalBackButton}"
				Text="←" />
			<Label
				Grid.Column="1"
				Style="{StaticResource SaphModalTitle}"
				Text="Avaliação Final" />
		</Grid>

		<Border Grid.Row="1" Style="{StaticResource SaphPatientCard}">
			<HorizontalStackLayout Spacing="10">
				<Label FontSize="22" Text="{Binding PatientEmoji}" VerticalOptions="Center" />
				<Label Style="{StaticResource SaphPatientSummary}" Text="{Binding PatientSummary}" />
			</HorizontalStackLayout>
		</Border>

		<Label
			Grid.Row="2"
			Style="{StaticResource SaphRequiredHint}"
			Text="* CAMPO OBRIGATÓRIO" />

		<ScrollView Grid.Row="3">
			<VerticalStackLayout Padding="16,0,16,24" Spacing="16">
				<Grid ColumnDefinitions="Auto,*" Style="{StaticResource SaphSectionHeaderBar}">
					<BoxView
						Grid.Column="0"
						WidthRequest="4"
						Color="{StaticResource SaphBoletimTeal}"
						VerticalOptions="Fill" />
					<Label
						Grid.Column="1"
						Margin="12,0,12,0"
						Style="{StaticResource SaphSectionHeaderTitle}"
						Text="Avaliação Final" />
				</Grid>

				<Border Style="{StaticResource SaphModalSectionCard}">
					<VerticalStackLayout Spacing="8">
						<Label
							FontSize="13"
							Style="{StaticResource SaphFieldCaption}"
							Text="Avaliação Final" />
						<Editor
							AutoSize="TextChanges"
							MinimumHeightRequest="120"
							Placeholder="Descreva a avaliação final..."
							Style="{StaticResource SaphFieldEditor}"
							Text="{Binding Form.TextoAvaliacao}" />
					</VerticalStackLayout>
				</Border>

				<Border Style="{StaticResource SaphModalSectionCard}">
					<VerticalStackLayout Spacing="10">
						<Label
							FontSize="13"
							Style="{StaticResource SaphFieldCaptionStrong}"
							Text="Questão Tipo Radio *" />
						<RadioButton
							x:Name="Rb1"
							CheckedChanged="OnRadioChecked"
							Color="{StaticResource SaphBoletimTeal}"
							Content="Radio 1"
							GroupName="QrAvalFinal"
							TextColor="{DynamicResource SaphModalFieldText}"
							Value="1" />
						<RadioButton
							x:Name="Rb2"
							CheckedChanged="OnRadioChecked"
							Color="{StaticResource SaphBoletimTeal}"
							Content="Radio 2"
							GroupName="QrAvalFinal"
							TextColor="{DynamicResource SaphModalFieldText}"
							Value="2" />
						<RadioButton
							x:Name="Rb3"
							CheckedChanged="OnRadioChecked"
							Color="{StaticResource SaphBoletimTeal}"
							Content="Radio 3"
							GroupName="QrAvalFinal"
							TextColor="{DynamicResource SaphModalFieldText}"
							Value="3" />
						<RadioButton
							x:Name="Rb4"
							CheckedChanged="OnRadioChecked"
							Color="{StaticResource SaphBoletimTeal}"
							Content="Radio 4"
							GroupName="QrAvalFinal"
							TextColor="{DynamicResource SaphModalFieldText}"
							Value="4" />
					</VerticalStackLayout>
				</Border>

				<Border Style="{StaticResource SaphModalSectionCard}">
					<VerticalStackLayout Spacing="16">
						<Label
							FontSize="13"
							Style="{StaticResource SaphFieldCaptionStrong}"
							Text="Questão Tipo Checkbox *" />
						<HorizontalStackLayout Spacing="12" VerticalOptions="Center">
							<CheckBox
								VerticalOptions="Start"
								Color="{StaticResource SaphBoletimTeal}"
								IsChecked="{Binding Form.Checkbox1, Mode=TwoWay}" />
							<VerticalStackLayout HorizontalOptions="Fill" Spacing="2" VerticalOptions="Center">
								<Label
									FontSize="14"
									Style="{StaticResource SaphFieldCaptionStrong}"
									Text="Situação clínica e desfecho" />
								<Label
									LineBreakMode="WordWrap"
									Style="{StaticResource SaphFieldCaption}"
									Text="Registo completo do estado do paciente e resultado no local." />
							</VerticalStackLayout>
						</HorizontalStackLayout>
						<HorizontalStackLayout Spacing="12" VerticalOptions="Center">
							<CheckBox
								VerticalOptions="Start"
								Color="{StaticResource SaphBoletimTeal}"
								IsChecked="{Binding Form.Checkbox2, Mode=TwoWay}" />
							<VerticalStackLayout HorizontalOptions="Fill" Spacing="2" VerticalOptions="Center">
								<Label
									FontSize="14"
									Style="{StaticResource SaphFieldCaptionStrong}"
									Text="Condutas e procedimentos" />
								<Label
									LineBreakMode="WordWrap"
									Style="{StaticResource SaphFieldCaption}"
									Text="Medicações, intervenções e curativos devidamente descritos." />
							</VerticalStackLayout>
						</HorizontalStackLayout>
						<HorizontalStackLayout Spacing="12" VerticalOptions="Center">
							<CheckBox
								VerticalOptions="Start"
								Color="{StaticResource SaphBoletimTeal}"
								IsChecked="{Binding Form.Checkbox3, Mode=TwoWay}" />
							<VerticalStackLayout HorizontalOptions="Fill" Spacing="2" VerticalOptions="Center">
								<Label
									FontSize="14"
									Style="{StaticResource SaphFieldCaptionStrong}"
									Text="Equipe e horários" />
								<Label
									LineBreakMode="WordWrap"
									Style="{StaticResource SaphFieldCaption}"
									Text="Identificação da equipe e registo de chegada / saída conferidos." />
							</VerticalStackLayout>
						</HorizontalStackLayout>
						<HorizontalStackLayout Spacing="12" VerticalOptions="Center">
							<CheckBox
								VerticalOptions="Start"
								Color="{StaticResource SaphBoletimTeal}"
								IsChecked="{Binding Form.Checkbox4, Mode=TwoWay}" />
							<VerticalStackLayout HorizontalOptions="Fill" Spacing="2" VerticalOptions="Center">
								<Label
									FontSize="14"
									Style="{StaticResource SaphFieldCaptionStrong}"
									Text="Pendências e encaminhamento" />
								<Label
									LineBreakMode="WordWrap"
									Style="{StaticResource SaphFieldCaption}"
									Text="Transferência, documentação entregue ou observações finais assinaladas." />
							</VerticalStackLayout>
						</HorizontalStackLayout>
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>
		</ScrollView>

		<Grid
			Grid.Row="4"
			ColumnDefinitions="*,*"
			Style="{StaticResource SaphModalFooterBar}">
			<Button
				Grid.Column="0"
				Command="{Binding VoltarCommand}"
				SemanticProperties.Description="Voltar sem guardar"
				Style="{StaticResource SaphSecondaryActionButton}"
				Text="VOLTAR" />
			<Button
				Grid.Column="1"
				Command="{Binding EnviarCommand}"
				SemanticProperties.Description="Enviar avaliação final"
				Style="{StaticResource SaphActionButton}"
				Text="ENVIAR" />
		</Grid>
	</Grid>
</ContentPage>
