<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="SaphMovel.Controls.OuvirPanel"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:conv="clr-namespace:SaphMovel.Converters">

	<!-- Pressionar = gravar, soltar = parar (toque nativo ligado no code-behind da página). -->
	<VerticalStackLayout Margin="0,8,0,0" Spacing="8">
		<Border
			x:Name="PressAreaBorder"
			BackgroundColor="Transparent"
			IsEnabled="{Binding IsTranscribing, Converter={StaticResource InvBool}}"
			MinimumHeightRequest="52"
			StrokeThickness="0">
			<Button
				Padding="16,14"
				BackgroundColor="{StaticResource SaphBoletimTeal}"
				CornerRadius="10"
				FontAttributes="Bold"
				FontSize="15"
				HorizontalOptions="Fill"
				InputTransparent="True"
				IsEnabled="{Binding IsTranscribing, Converter={StaticResource InvBool}}"
				MinimumHeightRequest="52"
				SemanticProperties.Description="Manter pressionado para ditar"
				Text="OUVIR"
				TextColor="{DynamicResource SaphOnActionButton}" />
		</Border>
		<Border
			Padding="12,10"
			BackgroundColor="{DynamicResource SaphRecordingTint}"
			InputTransparent="True"
			MinimumHeightRequest="48"
			Opacity="{Binding IsOuvirRecording, Converter={StaticResource BoolOpacity}}"
			Stroke="{StaticResource SaphRecordingStroke}"
			StrokeThickness="1">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="10" />
			</Border.StrokeShape>
			<HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
				<Ellipse
					HeightRequest="10"
					VerticalOptions="Center"
					WidthRequest="10"
					Fill="{StaticResource SaphRecordingStroke}" />
				<Label
					FontAttributes="Bold"
					FontSize="13"
					LineBreakMode="WordWrap"
					Text="{Binding OuvirHintText}"
					TextColor="{DynamicResource SaphRecordingText}"
					VerticalOptions="Center" />
			</HorizontalStackLayout>
		</Border>
		<Border
			Padding="12,10"
			BackgroundColor="{DynamicResource SaphProcessingTint}"
			IsVisible="{Binding IsTranscribing}"
			Stroke="{StaticResource SaphBoletimTeal}"
			StrokeThickness="1">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="10" />
			</Border.StrokeShape>
			<HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
				<ActivityIndicator
					Color="{StaticResource SaphBoletimTeal}"
					IsRunning="{Binding IsTranscribing}"
					VerticalOptions="Center" />
				<Label
					FontAttributes="Bold"
					FontSize="13"
					LineBreakMode="WordWrap"
					Text="{Binding OuvirHintText}"
					TextColor="{DynamicResource SaphProcessingText}"
					VerticalOptions="Center" />
			</HorizontalStackLayout>
		</Border>
	</VerticalStackLayout>
</ContentView>
