<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="SaphMovel.Controls.SaphInfoCard"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root">

	<Border Style="{StaticResource SaphChamadoInfoCard}">
		<VerticalStackLayout Spacing="4">
			<Label
				Style="{StaticResource SaphChamadoCaption}"
				Text="{Binding Caption, Source={x:Reference Root}}" />
			<Label
				Style="{StaticResource SaphChamadoValue}"
				FontSize="{Binding ValueFontSize, Source={x:Reference Root}}"
				Text="{Binding Value, Source={x:Reference Root}}" />
		</VerticalStackLayout>
	</Border>
</ContentView>
