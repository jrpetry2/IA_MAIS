<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="SaphMovel.Controls.SaphBoletimFooterTip"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<HorizontalStackLayout Spacing="10">
		<Label
			FontSize="18"
			Text="ⓘ"
			TextColor="{DynamicResource SaphTextSecondary}"
			VerticalOptions="Start" />
		<Label
			LineBreakMode="WordWrap"
			TextColor="{DynamicResource SaphBoletimTitle}"
			VerticalOptions="Center">
			<Label.FormattedText>
				<FormattedString>
					<Span FontAttributes="Bold" Text="Dica Importante: " />
					<Span Text="Preencha as informações do Boletim APH antes de concluir a missão." />
				</FormattedString>
			</Label.FormattedText>
		</Label>
	</HorizontalStackLayout>
</ContentView>
