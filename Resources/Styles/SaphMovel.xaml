<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!-- Typography: align FontSize with Figma text styles -->
	<Style x:Key="SaphPageTitle" TargetType="Label">
		<Setter Property="FontFamily" Value="OpenSansSemibold" />
		<Setter Property="FontSize" Value="22" />
		<Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SaphTextPrimary}, Dark={StaticResource SaphTextOnDark}}" />
	</Style>

	<Style x:Key="SaphSectionLabel" TargetType="Label">
		<Setter Property="FontFamily" Value="OpenSansSemibold" />
		<Setter Property="FontSize" Value="15" />
		<Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SaphTextPrimary}, Dark={StaticResource SaphTextOnDark}}" />
	</Style>

	<Style x:Key="SaphCaption" TargetType="Label">
		<Setter Property="FontFamily" Value="OpenSansRegular" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SaphTextSecondary}, Dark={StaticResource SaphTextMutedDark}}" />
	</Style>

	<Style x:Key="SaphCard" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SaphSurface}, Dark={StaticResource SaphSurfaceDark}}" />
		<Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SaphBorder}, Dark={StaticResource SaphBorderDark}}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Padding" Value="16,14" />
		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="12" />
		</Setter>
	</Style>

	<Style x:Key="SaphStatPill" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SaphSurface}, Dark={StaticResource SaphSurfaceDark}}" />
		<Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SaphBorder}, Dark={StaticResource SaphBorderDark}}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Padding" Value="12,10" />
		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="10" />
		</Setter>
	</Style>

	<Style x:Key="SaphPrimaryButton" TargetType="Button">
		<Setter Property="FontFamily" Value="OpenSansSemibold" />
		<Setter Property="FontSize" Value="15" />
		<Setter Property="TextColor" Value="{DynamicResource SaphOnAccent}" />
		<Setter Property="BackgroundColor" Value="{DynamicResource SaphAccent}" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="Padding" Value="18,14" />
		<Setter Property="MinimumHeightRequest" Value="48" />
	</Style>

	<!-- Chrome das páginas modais (Boletim APH, Alterar Endereço): antes copiado inline em cada página -->

	<Style x:Key="SaphModalPage" TargetType="ContentPage">
		<Setter Property="BackgroundColor" Value="{DynamicResource SaphModalSurface}" />
		<Setter Property="Shell.NavBarIsVisible" Value="False" />
	</Style>

	<Style x:Key="SaphModalHeaderBar" TargetType="Grid">
		<Setter Property="Padding" Value="4,8,12,8" />
		<Setter Property="ColumnSpacing" Value="0" />
		<Setter Property="BackgroundColor" Value="{DynamicResource SaphModalHeaderBg}" />
	</Style>

	<Style x:Key="SaphModalBackButton" TargetType="Button">
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="FontSize" Value="22" />
		<Setter Property="TextColor" Value="{DynamicResource SaphModalHeaderText}" />
		<Setter Property="SemanticProperties.Description" Value="Voltar" />
	</Style>

	<Style x:Key="SaphModalTitle" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="18" />
		<Setter Property="LineBreakMode" Value="TailTruncation" />
		<Setter Property="TextColor" Value="{DynamicResource SaphModalHeaderText}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>

	<Style x:Key="SaphPatientCard" TargetType="Border">
		<Setter Property="Margin" Value="16,8,16,0" />
		<Setter Property="Padding" Value="14,12" />
		<Setter Property="BackgroundColor" Value="{DynamicResource SaphModalCard}" />
		<Setter Property="Stroke" Value="{DynamicResource SaphModalStroke}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="14" />
		</Setter>
	</Style>

	<Style x:Key="SaphPatientSummary" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="15" />
		<Setter Property="LineBreakMode" Value="TailTruncation" />
		<Setter Property="TextColor" Value="{DynamicResource SaphModalFieldText}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>

	<Style x:Key="SaphModalSectionCard" TargetType="Border">
		<Setter Property="Padding" Value="14,12" />
		<Setter Property="BackgroundColor" Value="{DynamicResource SaphModalCard}" />
		<Setter Property="Stroke" Value="{DynamicResource SaphModalStroke}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="12" />
		</Setter>
	</Style>

	<Style x:Key="SaphRequiredHint" TargetType="Label">
		<Setter Property="Margin" Value="20,10,20,6" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="TextColor" Value="{DynamicResource SaphRequiredMark}" />
	</Style>

	<Style x:Key="SaphSectionHeaderBar" TargetType="Grid">
		<Setter Property="MinimumHeightRequest" Value="44" />
		<Setter Property="BackgroundColor" Value="{DynamicResource SaphModalSectionHeaderBg}" />
	</Style>

	<Style x:Key="SaphSectionHeaderTitle" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="LineBreakMode" Value="WordWrap" />
		<Setter Property="TextColor" Value="{DynamicResource SaphModalFieldText}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>

	<Style x:Key="SaphFieldCaption" TargetType="Label">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextColor" Value="{DynamicResource SaphModalLabel}" />
	</Style>

	<Style x:Key="SaphFieldCaptionStrong" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="LineBreakMode" Value="WordWrap" />
		<Setter Property="TextColor" Value="{DynamicResource SaphModalFieldText}" />
	</Style>

	<Style x:Key="SaphFieldEntry" TargetType="Entry">
		<Setter Property="BackgroundColor" Value="{DynamicResource SaphModalField}" />
		<Setter Property="PlaceholderColor" Value="{DynamicResource SaphModalPlaceholder}" />
		<Setter Property="TextColor" Value="{DynamicResource SaphModalFieldText}" />
	</Style>

	<Style x:Key="SaphFieldEditor" TargetType="Editor">
		<Setter Property="BackgroundColor" Value="{DynamicResource SaphModalField}" />
		<Setter Property="PlaceholderColor" Value="{DynamicResource SaphModalPlaceholder}" />
		<Setter Property="TextColor" Value="{DynamicResource SaphModalFieldText}" />
	</Style>

	<Style x:Key="SaphFieldPicker" TargetType="Picker">
		<Setter Property="BackgroundColor" Value="{DynamicResource SaphModalField}" />
		<Setter Property="TitleColor" Value="{DynamicResource SaphModalPlaceholder}" />
		<Setter Property="TextColor" Value="{DynamicResource SaphModalFieldText}" />
	</Style>

	<Style x:Key="SaphModalFooterBar" TargetType="Grid">
		<Setter Property="Padding" Value="16,12,16,20" />
		<Setter Property="ColumnSpacing" Value="12" />
		<Setter Property="BackgroundColor" Value="{DynamicResource SaphModalFooterBg}" />
	</Style>

	<Style x:Key="SaphSecondaryActionButton" TargetType="Button">
		<Setter Property="Padding" Value="12,14" />
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="BorderColor" Value="{DynamicResource SaphModalFieldText}" />
		<Setter Property="BorderWidth" Value="1" />
		<Setter Property="CornerRadius" Value="10" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="MinimumHeightRequest" Value="48" />
		<Setter Property="TextColor" Value="{DynamicResource SaphModalFieldText}" />
	</Style>

	<Style x:Key="SaphActionButton" TargetType="Button">
		<Setter Property="Padding" Value="12,14" />
		<Setter Property="BackgroundColor" Value="{StaticResource SaphBoletimTeal}" />
		<Setter Property="CornerRadius" Value="10" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="MinimumHeightRequest" Value="48" />
		<Setter Property="TextColor" Value="{DynamicResource SaphOnActionButton}" />
	</Style>

	<!-- MainPage: cartões info da aba CHAMADO e itens da barra de abas -->

	<Style x:Key="SaphChamadoInfoCard" TargetType="Border">
		<Setter Property="Padding" Value="14,14" />
		<Setter Property="BackgroundColor" Value="{DynamicResource SaphPrescricaoCardBg}" />
		<Setter Property="Stroke" Value="{DynamicResource SaphBoletimCardStroke}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="10" />
		</Setter>
	</Style>

	<Style x:Key="SaphChamadoInfoCardCompact" TargetType="Border" BasedOn="{StaticResource SaphChamadoInfoCard}">
		<Setter Property="Padding" Value="12,12" />
	</Style>

	<Style x:Key="SaphChamadoCaption" TargetType="Label">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextColor" Value="{DynamicResource SaphTextSecondary}" />
	</Style>

	<Style x:Key="SaphChamadoValue" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="15" />
		<Setter Property="LineBreakMode" Value="WordWrap" />
		<Setter Property="TextColor" Value="{DynamicResource SaphListTitle}" />
	</Style>

	<Style x:Key="SaphMainTabItem" TargetType="VerticalStackLayout">
		<Setter Property="Padding" Value="16,10,16,0" />
		<Setter Property="Spacing" Value="0" />
		<Setter Property="MinimumHeightRequest" Value="48" />
	</Style>

	<Style x:Key="SaphMainTabLabel" TargetType="Label">
		<Setter Property="FontSize" Value="15" />
		<Setter Property="HorizontalTextAlignment" Value="Center" />
		<Setter Property="LineBreakMode" Value="NoWrap" />
	</Style>

	<Style x:Key="SaphMainTabDivider" TargetType="BoxView">
		<Setter Property="WidthRequest" Value="1" />
		<Setter Property="Margin" Value="0,8,0,12" />
		<Setter Property="VerticalOptions" Value="Fill" />
	</Style>
</ResourceDictionary>
